# Copy to `.env` on each machine (robot + operator).

# LiveKit server (LiveKit Cloud, or a self-hosted `livekit-server --dev`).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Both sides must agree on the room name.
LIVEKIT_ROOM=xlerobot

# Unified Portal tick rate. Must match for both peers.
PORTAL_FPS=30

# -- Robot side ------------------------------------------------------------

# Calibration file namespace. Changes which JSON under
# $HF_LEROBOT_CALIBRATION/robots/xlerobot/ is used; useful if you have
# more than one physical robot you're switching between.
XLEROBOT_ID=xlerobot

# Feetech buses — see root QUICKSTART.md for bus/motor-ID layout.
XLEROBOT_PORT1=/dev/ttyACM0
XLEROBOT_PORT2=/dev/ttyACM1

# Safety clamp on how far each joint can travel per tick. Leave EMPTY
# for responsive teleop (matches SO-101 default — follower tracks the
# leader with no per-tick cap). Setting a value like 5.0 means "no joint
# moves more than 5%/tick" = 150%/s at 30 Hz; blocks large jumps from
# leader drift or reconnects but makes fast gestures lag. Off by default.
XLEROBOT_MAX_RELATIVE_TARGET=

# OpenCV camera device paths. Default resolution is 640x480 at MJPG;
# bump via XLEROBOT_CAM_WIDTH / XLEROBOT_CAM_HEIGHT (set on BOTH robot
# and operator machines — the schema needs to match). 720p is about
# 3x the encode/decode cost of 480p.
XLEROBOT_CAM_LEFT_WRIST=/dev/video0
XLEROBOT_CAM_RIGHT_WRIST=/dev/video2
XLEROBOT_CAM_HEAD=/dev/video4
XLEROBOT_CAM_WIDTH=640
XLEROBOT_CAM_HEIGHT=480

# Cameras to enable, comma-separated. Unset or empty = all three.
# Valid names: left_wrist, right_wrist, head.
# Used on both robot and operator sides — set identically on each machine.
# Example: XLEROBOT_CAMERAS=left_wrist,head
XLEROBOT_CAMERAS=

# -- Operator side ---------------------------------------------------------

# Rotate the keyboard x/y velocity frame. Use when the robot's forward axis
# doesn't match the operator's w/s keys. Valid values: 0, 90, 180, 270 (CCW).
XLEROBOT_BASE_ROTATION=0

SO101_LEFT_LEADER_PORT=/dev/tty.usbmodem11101
SO101_RIGHT_LEADER_PORT=/dev/tty.usbmodem11201
SO101_LEFT_LEADER_ID=so101_left_leader
SO101_RIGHT_LEADER_ID=so101_right_leader

# Set to 1 if the robot's arms are wired opposite to their logical names
# (physical left-side arm is on bus2 instead of bus1 etc.). Inverts the
# leader → follower mapping on the operator side only. Easier than
# rewiring the Feetech boards. Cameras aren't affected — swap the
# XLEROBOT_CAM_LEFT_WRIST / _RIGHT_WRIST paths on the robot side
# separately if the wrist labels also need to flip.
XLEROBOT_SWAP_ARMS=0

# LeRobotDataset output (the operator machine writes this locally).
# Local root defaults to $HF_LEROBOT_HOME/<repo_id> unless overridden.
XLEROBOT_DATASET_REPO_ID=pham-tuan-binh/xlerobot-bimanual
XLEROBOT_DATASET_ROOT=
XLEROBOT_DATASET_TASK="bimanual manipulation"

# Portal sync-buffer reuse-stale-frames behavior on the operator side.
# 1 (default) = every state becomes an observation, reusing the last
# video frame when no fresh one is in the window (good for recording).
# 0 = strict match; state without fresh video is dropped. Use 0 as a
# workaround if you hit the Portal bug where sync_delta grows linearly
# and `blocker` is sticky on one track despite equal receive rates.
XLEROBOT_REUSE_STALE_FRAMES=1

# -- Deploy helper (scripts/deploy_to_robot.sh) ----------------------------
# Used by the rsync wrapper so you don't have to type REMOTE=... each run.
# Override on a single invocation by passing REMOTE=... on the command line.
XLEROBOT_ROBOT_REMOTE=
XLEROBOT_ROBOT_REMOTE_ROOT=~/workspace

# Patterns for scripts/deploy_to_robot.sh. Same syntax as .gitignore —
# one glob per line, `#` for comments, blank lines ignored. Loaded via
# `rsync --exclude-from=…`. Applies to both the XLeRobot/ and
# livekit-portal/ trees.
#
# What's NOT in here is shipped — in particular `.env` *is* synced, so
# the robot picks up your LIVEKIT_* / XLEROBOT_* config without retype.
# Put per-machine overrides in `.env.local`; it's excluded below.

# Version control
.git/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Rust build output — large and arch-specific. The robot rebuilds via
# livekit-portal/scripts/build_ffi_python.sh.
target/

# macOS-built dylib + UniFFI bindings won't run on the robot's arch;
# build_ffi_python.sh on the robot replaces both.
liblivekit_portal_ffi.dylib
liblivekit_portal_ffi.so
livekit_portal_ffi.py

# LeRobotDataset lands here; the robot never writes a dataset locally.
.cache/

# JS scratch (documentation site builds etc.)
node_modules/

# Editor/OS noise
.vscode/
.idea/
.DS_Store

# Per-machine overrides — each machine keeps its own `.env.local`.
.env.local
